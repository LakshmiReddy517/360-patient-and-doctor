# ============================================================================
# 360° Patient Care — backend environment variables
# Copy this file to `.env` (or export in your shell / set on your host) and
# fill in REAL values. NEVER commit the real `.env`. Production MUST set these.
# ============================================================================

# ---- Database (MySQL) ----
DB_URL=jdbc:mysql://localhost:3306/pcare?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=pcare
DB_PASSWORD=change-me

# ---- JWT signing secret ----
# Use a long random string. Generate one with:  openssl rand -hex 32
APP_SECURITY_JWT_SECRET=change-me-to-a-long-random-hex-string

# ---- SMS / OTP via MSG91 (optional — blank = SMS disabled, OTP still works in-app) ----
MSG91_AUTHKEY=
MSG91_OTP_TEMPLATE=

# ---- Firebase push (optional — absolute path to the service-account JSON) ----
FIREBASE_CREDENTIALS=

# ---- Demo data seeding (keep false on an existing DB) ----
# Also passable as a launch arg: --app.seed.enabled=false
APP_SEED_ENABLED=false
